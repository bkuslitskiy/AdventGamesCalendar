# Template: `npm run build` writes public/_headers from this, with %SCRIPT_HASHES% filled in (the inline
# import map in public/index.html changes every build). Pages applies these to static files only; the
# Functions under /api set their own headers. Cloudflare Web Analytics, which Cloudflare injects on the
# custom domain, needs its script host in script-src and its beacon endpoint in connect-src (it may also
# report to /cdn-cgi/rum on the site itself, which 'self' covers).
/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' %SCRIPT_HASHES% https://static.cloudflareinsights.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/words.txt
  Cache-Control: public, max-age=86400
